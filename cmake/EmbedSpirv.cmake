if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "INPUT, OUTPUT, and SYMBOL are required")
endif()

file(READ ${INPUT} shader_bytes HEX)
string(LENGTH "${shader_bytes}" shader_hex_length)
math(EXPR shader_byte_count "${shader_hex_length} / 2")
math(EXPR shader_alignment_check "${shader_byte_count} % 4")
if(NOT shader_alignment_check EQUAL 0)
    message(FATAL_ERROR "${INPUT} is not aligned to a 32-bit word")
endif()

set(shader_values "")
set(shader_offset 0)
while(shader_offset LESS shader_hex_length)
    string(SUBSTRING "${shader_bytes}" ${shader_offset} 2 byte)
    string(APPEND shader_values "0x${byte},")
    math(EXPR shader_offset "${shader_offset} + 2")
    math(EXPR shader_column "${shader_offset} % 32")
    if(shader_offset LESS shader_hex_length AND
        shader_column EQUAL 0)
        string(APPEND shader_values "\n    ")
    endif()
endwhile()

string(MAKE_C_IDENTIFIER ${SYMBOL} symbol)

set(symbol_parts)
string(REPLACE "_" ";" symbol_parts ${symbol})
set(symbol_pascal "")
foreach(part IN LISTS symbol_parts)
    string(SUBSTRING "${part}" 0 1 first)
    string(TOUPPER "${first}" first)
    string(LENGTH "${part}" part_length)
    set(rest "")
    if(part_length GREATER 1)
        string(SUBSTRING "${part}" 1 -1 rest)
    endif()
    string(APPEND symbol_pascal "${first}${rest}")
endforeach()

string(CONCAT generated_content
"// Generated by Hotaru's shader build. Do not edit.\n"
"#pragma once\n"
"\n"
"#include <array>\n"
"#include <cstdint>\n"
"#include <span>\n"
"\n"
"namespace hotaru::shaders {\n"
"\n"
"alignas(4) inline constexpr std::array<std::uint8_t, ${shader_byte_count}>\n"
"    k${symbol_pascal}{\n"
"    ${shader_values}\n"
"};\n"
"\n"
"inline std::span<const std::uint8_t> ${symbol_pascal}()\n"
"{\n"
"    return k${symbol_pascal};\n"
"}\n"
"\n"
"} // namespace hotaru::shaders\n"
)

set(temporary_output "${OUTPUT}.tmp")
file(WRITE ${temporary_output} "${generated_content}")
execute_process(
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
        ${temporary_output} ${OUTPUT}
    RESULT_VARIABLE copy_result
)
file(REMOVE ${temporary_output})
if(NOT copy_result EQUAL 0)
    message(FATAL_ERROR "Failed to write ${OUTPUT}")
endif()
